# Replace current process
alias ez="exec zsh"

# Navigation
alias la="ls --all"
alias ll="eza --long --all --header"
alias lt="eza --tree --level=1 --icons"
alias ltt="eza --tree --level=2 --icons"
alias lttt="eza --tree --level=3 --icons"
alias ltttt="eza --tree --level=4 --icons"

# Git
alias g="git"
alias ga="git add"
alias gap="git add -p"
alias gb="git branch"
alias gc="git commit"
alias gcb="git checkout -b"
alias gd="git diff"
alias gds="git diff --staged"
alias gf="git fetch"
alias gl="git log"
alias gcm="git commit -m"
alias gp="git push"
alias gpl="git pull"
alias gr="git restore"
alias grs="git restore --staged"
alias gs="git status"

# Clear output
alias c="clear"

# Python
alias ur="uv run"
