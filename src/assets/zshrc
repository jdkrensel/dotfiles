#!/bin/zsh


# Get the directory where this zshrc file is located
# Since .zshrc is always symlinked by the install script, follow the symlink.
# Strip everything from /src/assets/ on rather than the exact filename: a
# machine override lives at src/assets/machines/<category>/zshrc, and anchoring
# on the shared path would leave DOTFILES_DIR garbage on any machine using one.
DOTFILES_DIR="$(readlink ~/.zshrc | sed 's|/src/assets/.*$||')/src"

# Source aliases and functions from the assets directory
source "$DOTFILES_DIR/assets/aliases"
source "$DOTFILES_DIR/assets/functions"
export PATH="${DOTFILES_DIR%/src}/bin:$PATH"

# opencode installs its binary here; the installer is run with --no-modify-path
# so it does not append to this file.
export PATH="$HOME/.opencode/bin:$PATH"

# uv drops its shims — and anything it installs, claude included — in ~/.local/bin.
# This must stay ahead of the Zellij autostart below: that block ends in `exit`, so
# anything after it never runs in the shell that spawns the Zellij server. A pane
# resurrected from a snapshot is exec'd by that server directly, not through zsh, so
# a command missing from the server's PATH comes back as "Command not found".
. "$HOME/.local/bin/env"

# Configure Homebrew before all packages managed by homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"

# Auto-start Zellij: attach to a single persistent session named "main", creating
# it if it doesn't exist yet. Zellij runs the session in its own server process, so
# closing the window — or Ghostty crashing — only kills the client: on_force_close
# defaults to "detach", the server keeps every tab and process alive, and reopening
# reattaches to the live session. Only a reboot (or an explicit kill-session) takes
# the server down; that case is covered by the snapshot `session_serialization`
# writes, see config.kdl. Cmd+s opens the session manager to browse/attach/kill.
# Skipped inside an existing session ($ZELLIJ set, so panes don't nest) and for
# non-interactive shells. Disable on a machine by exporting ZELLIJ_AUTO_START=false.
# The command-exists guard keeps a missing zellij from exiting the shell.
# The `-t 1` (stdout is a tty) guard stops zellij from launching when an editor
# like Zed spawns a login shell just to capture the environment — there's no
# terminal there, so zellij would panic enabling raw mode. $ZED_TERM is also
# skipped so the integrated terminal doesn't nest a session.
if [[ $- == *i* && -t 1 && -z "$ZELLIJ" && -z "$ZED_TERM" && "${ZELLIJ_AUTO_START:-true}" == "true" ]] && command -v zellij >/dev/null; then
  zellij attach --create main
  exit
fi

#------------------------------------------------------------------
# Tab autocompletion menu
#------------------------------------------------------------------

# Set LS_COLORS variable for both eza and compinit
# Cache vivid output so it doesn't run on every shell start
_vivid_cache="${XDG_CACHE_HOME:-$HOME/.cache}/vivid_ls_colors"
if [[ ! -f "$_vivid_cache" ]]; then
  mkdir -p "${_vivid_cache:h}"
  vivid generate solarized-dark > "$_vivid_cache"
fi
export LS_COLORS="$(<"$_vivid_cache")"
unset _vivid_cache
#To preview all vivid themes:
#for theme in $(vivid themes); do
#    echo "Theme: $theme"
#    LS_COLORS=$(vivid generate $theme)
#    ls
#    echo
#done

# Use a menu for completion selection
zstyle ':completion:*' menu select

# Make completion case-insensitive
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# Group completions by type
zstyle ':completion:*' group-name ''

# Add color to the completion menu
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# Add helpful descriptions to some completions
zstyle ':completion:*:descriptions' format '%F{green}-- %d --%f'

# Load the completion system, using a cache file for speed
# Only run compaudit/compinit if the dump is missing or older than 24 hours
autoload -Uz compinit
if [[ ! -f ~/.zcompdump || -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit -i -d ~/.zcompdump
else
  compinit -C -i -d ~/.zcompdump
fi

#------------------------------------------------------------------
# Program configurations
#------------------------------------------------------------------

# Configure starship
eval "$(starship init zsh)"

# Configure cargo
. "$HOME/.cargo/env"

# Configure fnm
eval "$(fnm env --use-on-cd --shell zsh)"

# Configure zsh-autosuggestions
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#555555" # muted gray
ZSH_AUTOSUGGEST_STRATEGY=(history completion)

# Configure zsh-syntax-highlighting
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# Configure Java
if [[ -d "/opt/homebrew/opt/openjdk" ]]; then
  export JAVA_HOME="/opt/homebrew/opt/openjdk"
  export PATH="$JAVA_HOME/bin:$PATH"
fi

# Configure Go
export PATH="/usr/local/go/bin:$PATH"
export PATH="/Users/jessekrensel/go/bin:$PATH"

# Configure gcloud
# The Google Cloud SDK refuses to run under the macOS system Python (3.9); it needs
# 3.10-3.14. Take the newest uv-managed interpreter in that range. The upper bound is
# gcloud's, not uv's, so a newer interpreter is deliberately skipped rather than handed
# to a gcloud that would reject it. No match leaves CLOUDSDK_PYTHON unset, so gcloud
# falls back to its own default.
for _gcloud_python in "$HOME"/.local/bin/python3.{14..10}; do
  if [[ -x "$_gcloud_python" ]]; then
    export CLOUDSDK_PYTHON="$_gcloud_python"
    break
  fi
done
unset _gcloud_python

# Machine-specific config (work-vs-personal): PATH entries, work env vars,
# credentials, etc. This file is NOT tracked in dotfiles — create it by hand
# on each machine. A missing file is silently skipped (the [ -f ] guard), so a
# personal machine with no ~/.zshrc.local simply runs none of it.
[ -f ~/.zshrc.local ] && source ~/.zshrc.local

#------------------------------------------------------------------
# History Settings
#------------------------------------------------------------------
HISTSIZE=10000                  # How many lines of history to keep in memory
SAVEHIST=10000                  # How many lines to save to the history file
HISTFILE=~/.zsh_history         # Where to save history
setopt INC_APPEND_HISTORY       # Append commands to history immediately
setopt SHARE_HISTORY            # Share history between all open terminals
setopt HIST_IGNORE_ALL_DUPS     # If you type the same command twice in a row, only save it once
setopt HIST_IGNORE_SPACE        # Commands starting with a space are not saved to history
setopt HIST_FIND_NO_DUPS        # When searching, don't show repeated commands

# Drop duplicate PATH entries. A nested shell (a Zellij pane, `exec zsh`) inherits
# PATH and then runs this file again, so every prepend above repeats. This stays
# last: -U only dedupes when the array is set, and `export PATH=...` skips it.
typeset -U path
