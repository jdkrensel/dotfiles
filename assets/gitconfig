[user]
	name = Jesse Krensel
	# email is intentionally NOT set here — it is configured per-machine in
	# ~/.gitconfig.local (untracked), pulled in via the [include] at the bottom.
	# useConfigOnly makes git refuse to fabricate an identity from
	# username@hostname when that file is missing — it fails loudly instead.
	useConfigOnly = true

[init]
    defaultBranch = main

[core]
    editor = vim

[merge]
    conflictStyle = zdiff3

[diff]
	colorMoved = plain
	colorMovedWS = allow-indentation-change
[push]
	autoSetupRemote = true

# Machine-specific overrides (identity/email, work-vs-personal, etc.).
# This file is NOT tracked in dotfiles — create it by hand on each machine.
# A missing file is silently ignored, so an unconfigured machine has no email
# and git will refuse to commit until you set one (fails loudly, by design).
[include]
	path = ~/.gitconfig.local
