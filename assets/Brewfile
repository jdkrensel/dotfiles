brew "eza"      # Backs the ll and lt* listing aliases in aliases
brew "fd"       # File search that AGENTS.md tells agents to prefer over find
brew "fnm"      # Switches Node versions per project on cd (zshrc)
brew "git"      # Version control, configured by the tracked gitconfig
brew "jq"       # Parses hook JSON in the Claude status line and work hooks
brew "ripgrep"  # Content search that AGENTS.md tells agents to prefer over grep -r
brew "starship" # Draws the shell prompt (zshrc, config/starship.toml)
brew "vivid"    # Generates the solarized-dark LS_COLORS for eza and completion
brew "zellij"   # Multiplexer that zshrc auto-attaches to the "main" session
brew "zsh-autosuggestions" # History and completion suggestions, sourced by zshrc
brew "zsh-syntax-highlighting" # Command-line highlighting, sourced by zshrc

cask "ghostty"  # Terminal emulator, configured by config/ghostty/config
cask "zed"      # Editor, configured by config/zed (settings, keymap, theme)
